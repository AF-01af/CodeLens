# PostgreSQL (used by Docker Compose and Spring Boot)
POSTGRES_DB=codelens
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens
POSTGRES_PORT=5432

# JDBC URL for the Spring Boot API
DATABASE_URL=jdbc:postgresql://localhost:5432/codelens

# Spring Boot
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js frontend — points at the Spring Boot API
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional / future — AI providers (not used yet)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
