
generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   // "student" | "professor"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentsCreated Assignment[]    @relation("AssignmentCreator")
  submissions        Submission[]
  reviewsGiven       ReviewPairing[] @relation("Reviewer")
  gradesGiven        Grade[]         @relation("GraderProfessor")
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  dueDate     DateTime
  professorId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professor   User            @relation("AssignmentCreator", fields: [professorId], references: [id])
  submissions Submission[]
  pairings    ReviewPairing[]
}

model Submission {
  id              String   @id @default(cuid())
  assignmentId    String
  userId          String
  codeFileContent String
  submittedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignment Assignment      @relation(fields: [assignmentId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  pairings   ReviewPairing[]
  grade      Grade?
}

model ReviewPairing {
  id           String   @id @default(cuid())
  assignmentId String
  submissionId String
  reviewerId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User       @relation("Reviewer", fields: [reviewerId], references: [id])
  review     Review?
}

model Review {
  id          String   @id @default(cuid())
  pairingId   String   @unique
  content     String
  status      String
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pairing ReviewPairing @relation(fields: [pairingId], references: [id])
}

model Grade {
  id           String   @id @default(cuid())
  finalScore   Int
  submissionId String   @unique
  professorId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  professor  User       @relation("GraderProfessor", fields: [professorId], references: [id])
}