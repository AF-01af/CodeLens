
generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   // "STUDENT" | "PROFESSOR"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentsCreated Assignment[]       @relation("AssignmentCreator")
  submissions        Submission[]
  reviewsGiven       ReviewPairing[]    @relation("Reviewer")
  gradesGiven        Grade[]            @relation("GraderProfessor")
  coursesOwned       Course[]           @relation("CourseOwner")
  enrollments        CourseEnrollment[] @relation("Enrolled")
  reviewGradesGiven  ReviewGrade[]      @relation("ReviewGrader")
}

model Course {
  id          String   @id @default(cuid())
  name        String
  joinCode    String   @unique
  professorId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professor   User               @relation("CourseOwner", fields: [professorId], references: [id])
  enrollments CourseEnrollment[]
  assignments Assignment[]
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  joinedAt  DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id])
  student User   @relation("Enrolled", fields: [studentId], references: [id])

  @@unique([courseId, studentId])
}

model Assignment {
  id            String   @id @default(cuid())
  title         String
  description   String
  dueDate       DateTime
  reviewDueDate DateTime
  courseId      String
  professorId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course      Course          @relation(fields: [courseId], references: [id])
  professor   User            @relation("AssignmentCreator", fields: [professorId], references: [id])
  submissions Submission[]
  pairings    ReviewPairing[]
}

model Submission {
  id              String   @id @default(cuid())
  assignmentId    String
  userId          String
  codeFileContent String
  submittedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignment Assignment      @relation(fields: [assignmentId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  pairings   ReviewPairing[]
  grade      Grade?

  @@unique([assignmentId, userId])
}

model ReviewPairing {
  id           String   @id @default(cuid())
  assignmentId String
  submissionId String
  reviewerId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   User       @relation("Reviewer", fields: [reviewerId], references: [id])
  review     Review?

  @@unique([submissionId, reviewerId])
}

model Review {
  id          String   @id @default(cuid())
  pairingId   String   @unique
  content     String
  status      String
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pairing ReviewPairing @relation(fields: [pairingId], references: [id])
  grade   ReviewGrade?
}

model Grade {
  id           String    @id @default(cuid())
  finalScore   Int
  feedback     String?
  releasedAt   DateTime?
  submissionId String    @unique
  professorId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  professor  User       @relation("GraderProfessor", fields: [professorId], references: [id])
}

model ReviewGrade {
  id          String    @id @default(cuid())
  reviewId    String    @unique
  score       Int
  feedback    String?
  releasedAt  DateTime?
  professorId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  review    Review @relation(fields: [reviewId], references: [id])
  professor User   @relation("ReviewGrader", fields: [professorId], references: [id])
}
