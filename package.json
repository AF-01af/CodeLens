{
  "name": "codelens",
  "version": "0.1.0",
  "private": true,
  "description": "CodeLens — peer code review platform for CS courses",
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "typecheck": "npm run typecheck --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "dev:api": "cd apps/api && ./mvnw spring-boot:run",
    "test:api": "cd apps/api && ./mvnw test",
    "build:api": "cd apps/api && ./mvnw -DskipTests package"
  },
  "engines": {
    "node": ">=20"
  }
}
